import java.util.*;
import java_cup.runtime.*;

parser code {:
    private final List<ParameterTerm> parameters = new ArrayList<>();
    private String sourceSql;
    private int derivedNumber;
    public String derivedName() { return "subquery_" + (++derivedNumber); }

    public void setSourceSql(String sql) { sourceSql = sql; }
    public String expressionSql(int start, int end) {
        if (sourceSql == null) { throw new IllegalArgumentException("Schema expressions require SQL source text"); }
        return sourceSql.substring(start, end);
    }

    public ParameterTerm parameter(int index) {
        ParameterTerm term = new ParameterTerm(index);
        parameters.add(term);
        return term;
    }

    public void bindParameters(List<?> values) {
        if (values.size() != parameters.size()) {
            throw new IllegalArgumentException("Expected " + parameters.size() + " parameter value(s)");
        }
        for (ParameterTerm parameter : parameters) { parameter.bind(values.get(parameter.getIndex())); }
    }

    public void syntax_error(Symbol token) {
        throw new InvalidSyntaxException("Syntax error at character " + token.left + ": " + token.value);
    }
    public void unrecovered_syntax_error(Symbol token) {
        syntax_error(token);
    }
:};

action code {:
    private ArrayList<String> names(ArrayList<Column> columns) {
        ArrayList<String> names = new ArrayList<>();
        for(Column column : columns) {
            if(column.getTable()!=null) throw new IllegalArgumentException("Key columns cannot be qualified");
            names.add(column.getName());
        }
        return names;
    }
    private Long limitInteger(java.math.BigInteger value) {
        try { return value.longValueExact(); }
        catch (ArithmeticException e) { throw new InvalidSyntaxException("LIMIT integer is out of range"); }
    }
    private ConditionalExpression predicate(CompareTerm expression) {
        return expression instanceof ConditionalExpression ? (ConditionalExpression) expression
                : new TruthExpression(expression);
    }
    private SchemaDefinition define(Column column, int type, Number length, ColumnOptions options) {
        column.setType(type);
        if (length != null) {
            if (length.doubleValue() < 1 || length.doubleValue() > 32767) {
                throw new IllegalArgumentException("Column length must be between 1 and 32767 bytes");
            }
            long size = length.longValue();
            column.setLength((int) size);
        }
        column.applyOpts(options);
        return new SchemaDefinition().addColumn(column, options);
    }
:};

terminal SELECT, FROM, WHERE, DISTINCT, ALL, AS, LIMIT, OFFSET;
terminal CREATE, DROP, TABLE, IF, EXISTS, PRIMARY, KEY, NOT, NULL;
terminal DEFAULT, UNIQUE, CHECK, REFERENCES, FOREIGN, CONSTRAINT;
terminal ALTER, ADD, COLUMN, RENAME, TO;
terminal INDEX, EXPLAIN, QUERY, PLAN;
terminal WITH, UNION, INTERSECT, EXCEPT;
terminal CASE, WHEN, THEN, ELSE, CAST, CURRENT_DATE, CURRENT_TIME, CURRENT_TIMESTAMP;
terminal CONFLICT, DO, NOTHING, RETURNING;
terminal CASCADE, RESTRICT, NO, ACTION, DEFERRABLE, INITIALLY, DEFERRED, IMMEDIATE;
terminal SAVEPOINT, RELEASE;
terminal REAL, CHAR, VARCHAR, TEXT;
terminal String INTEGER;
terminal INSERT, INTO, VALUES, UPDATE, SET, DELETE;
terminal BEGIN, WORK, TRANSACTION, COMMIT, ROLLBACK, END;
terminal AND, OR, IS, LIKE, CLIKE, IN, BETWEEN;
terminal JOIN, INNER, LEFT, OUTER, CROSS, ON;
terminal GROUP, BY, HAVING, ORDER, ASC, DESC;
terminal LPAREN, RPAREN, COMMA, DOT, STAR, SEMICOLON;
terminal EQ, NOTEQ, LT, GT, LTEQ, GTEQ, PLUS, MINUS, DIVIDE, REMAINDER, CONCAT;
terminal String ID, STRING;
terminal java.math.BigInteger INT_VAL;
terminal Double REAL_VAL;
terminal Integer PARAMETER;

non terminal SQLStatement statement, command;
non terminal CreateStatement create_statement;
non terminal DropStatement drop_statement;
non terminal SelectStatement select_core;
non terminal QueryStatement query, compound_query;
non terminal ArrayList<CteDefinition> optional_with, cte_list;
non terminal CteDefinition cte;
non terminal InsertStatement insert_statement, insert_body;
non terminal Upsert upsert_clause;
non terminal ArrayList<Column> conflict_target;
non terminal ArrayList<Object> returning_clause;
non terminal UpdateStatement update_statement;
non terminal DeleteStatement delete_statement;
non terminal Table table, table_reference;
non terminal String alias, optional_alias, optional_outer;
non terminal Boolean distinct, direction, if_exists, if_not_exists, index_unique;
non terminal Object optional_work, optional_column, optional_savepoint;
non terminal ArrayList<Column> column_list, insert_columns, assignments;
non terminal SchemaDefinition definitions, column_definition;
non terminal Column column, assignment;
non terminal ColumnOptions column_options;
non terminal Object default_value;
non terminal ArrayList<String> parent_columns;
non terminal ForeignKey reference_clause;
non terminal ReferenceOptions reference_actions;
non terminal String reference_action;
non terminal Boolean reference_deferred, initially_deferred;
non terminal ArrayList<Object> select_list;
non terminal SelectItem select_item;
non terminal FromClause from_clause, from_list;
non terminal ArrayList<CompareTerm> expressions, group_clause, optional_expressions;
non terminal ArrayList<OrderBy> order_clause, order_list;
non terminal OrderBy ordering;
non terminal ConditionalExpression where_clause, having_clause, condition;
non terminal CompareTerm expression, disjunction, conjunction, factor, comparison;
non terminal CompareTerm additive, multiplicative, concatenation, unary, scalar;
non terminal CompareTerm case_base, case_else;
non terminal ArrayList<CompareTerm> case_branches;
non terminal String cast_type;
non terminal Limit limit_clause;
non terminal Long signed_integer;
non terminal CompareTerm limit_value;
non terminal ArrayList<ArrayList<Object>> value_rows;

start with statement;

statement ::= command:c SEMICOLON {: RESULT = c; :};

command ::= create_statement:c {: RESULT = c; :}
          | CREATE index_unique:u INDEX if_not_exists:o ID:n ON table:t LPAREN ID:c RPAREN
            {: RESULT = new IndexStatement(n, t, c, u, o); :}
          | DROP INDEX if_exists:o ID:n {: RESULT = new IndexStatement(n, null, null, false, o); :}
          | EXPLAIN QUERY PLAN query:s {: RESULT = new ExplainStatement(s); :}
          | ALTER TABLE table:t ADD optional_column column_definition:d
            {: RESULT = new AlterStatement(t, null, null, d); :}
          | ALTER TABLE table:t RENAME TO ID:n {: RESULT = new AlterStatement(t, null, n, null); :}
          | ALTER TABLE table:t RENAME optional_column ID:c TO ID:n
            {: RESULT = new AlterStatement(t, c, n, null); :}
          | ALTER TABLE table:t DROP optional_column ID:c {: RESULT = new DropColumnStatement(t, c); :}
          | drop_statement:c {: RESULT = c; :}
          | query:c {: RESULT = c; :}
          | WITH cte_list:d insert_statement:i {: RESULT = new WithStatement(d, i); :}
          | WITH cte_list:d update_statement:i {: RESULT = new WithStatement(d, i); :}
          | WITH cte_list:d delete_statement:i {: RESULT = new WithStatement(d, i); :}
          | insert_statement:c {: RESULT = c; :}
          | update_statement:c {: RESULT = c; :}
          | delete_statement:c {: RESULT = c; :}
          | BEGIN optional_work {: RESULT = new BeginStatement(); :}
          | COMMIT optional_work {: RESULT = new CommitStatement(); :}
          | END optional_work {: RESULT = new CommitStatement(); :}
          | ROLLBACK optional_work {: RESULT = new RollbackStatement(); :}
          | SAVEPOINT ID:n {: RESULT = new SavepointStatement("SAVEPOINT", n); :}
          | RELEASE optional_savepoint ID:n {: RESULT = new SavepointStatement("RELEASE", n); :}
          | ROLLBACK optional_work TO optional_savepoint ID:n {: RESULT = new SavepointStatement("ROLLBACK", n); :};
optional_work ::= WORK | TRANSACTION | ;
optional_column ::= COLUMN | ;
optional_savepoint ::= SAVEPOINT | ;
index_unique ::= UNIQUE {: RESULT = true; :} | {: RESULT = false; :};

table ::= ID:n {: RESULT = new Table(n); :};
column ::= ID:n {: RESULT = new Column(n); :}
         | ID:t DOT ID:n {: RESULT = new Column(n, new Table(t)); :};

create_statement ::= CREATE TABLE if_not_exists:i table:t LPAREN definitions:c RPAREN
    {: RESULT = new CreateStatement(t, c); RESULT.setIfNotExists(i); :};
if_not_exists ::= IF NOT EXISTS {: RESULT = true; :} | {: RESULT = false; :};
definitions ::= column_definition:c {: RESULT = c; :}
    | definitions:d COMMA column_definition:c {: RESULT = d.append(c); :}
    | definitions:d COMMA PRIMARY KEY LPAREN column_list:c RPAREN
      {: d.finishColumns(); d.primaryKey(names(c)); RESULT = d; :}
    | definitions:d COMMA UNIQUE LPAREN column_list:c RPAREN
      {: d.finishColumns(); d.uniqueKey(names(c)); RESULT = d; :}
    | definitions:d COMMA CHECK LPAREN expression:e RPAREN
      {: d.finishColumns(); d.check(parser.expressionSql(eleft, eright)); RESULT = d; :}
    | definitions:d COMMA FOREIGN KEY LPAREN column_list:c RPAREN reference_clause:f reference_deferred:b
      {: d.finishColumns(); d.reference(f.withColumns(names(c)).withDeferred(b)); RESULT = d; :}
    | definitions:d COMMA CONSTRAINT ID:n PRIMARY KEY LPAREN column_list:c RPAREN
      {: d.finishColumns(); d.primaryKey(names(c)); d.nameLast(n); RESULT = d; :}
    | definitions:d COMMA CONSTRAINT ID:n UNIQUE LPAREN column_list:c RPAREN
      {: d.finishColumns(); d.uniqueKey(names(c)); d.nameLast(n); RESULT = d; :}
    | definitions:d COMMA CONSTRAINT ID:n CHECK LPAREN expression:e RPAREN
      {: d.finishColumns(); d.check(parser.expressionSql(eleft, eright)); d.nameLast(n); RESULT = d; :}
    | definitions:d COMMA CONSTRAINT ID:n FOREIGN KEY LPAREN column_list:c RPAREN reference_clause:f reference_deferred:b
      {: d.finishColumns(); d.reference(f.withColumns(names(c)).withDeferred(b)); d.nameLast(n); RESULT = d; :};
column_definition ::= column:c INTEGER:t column_options:o
    {: c.setDeclaredInteger(t.equals("INTEGER")); RESULT = define(c, Column.INTEGER, null, o); :}
    | column:c REAL column_options:o {: RESULT = define(c, Column.REAL, null, o); :}
    | column:c TEXT column_options:o {: RESULT = define(c, Column.VARCHAR, 32767L, o); :}
    | column:c VARCHAR LPAREN INT_VAL:n RPAREN column_options:o {: RESULT = define(c, Column.VARCHAR, n, o); :}
    | column:c VARCHAR column_options:o {: RESULT = define(c, Column.VARCHAR, 32767L, o); :}
    | column:c CHAR LPAREN INT_VAL:n RPAREN column_options:o {: RESULT = define(c, Column.CHAR, n, o); :}
    | column:c CHAR column_options:o {: RESULT = define(c, Column.CHAR, 1L, o); :};
column_options ::= column_options:o PRIMARY KEY {: RESULT = o.primaryKey(); :}
    | column_options:o NOT NULL {: RESULT = o.notNull(); :}
    | column_options:o UNIQUE {: RESULT = o.unique(); :}
    | column_options:o DEFAULT default_value:v {: RESULT = o.defaultValue(v); :}
    | column_options:o DEFAULT LPAREN expression:e RPAREN
      {: RESULT = o.defaultExpression("(" + parser.expressionSql(eleft, eright) + ")"); :}
    | column_options:o DEFAULT CURRENT_DATE {: RESULT = o.defaultExpression("CURRENT_DATE"); :}
    | column_options:o DEFAULT CURRENT_TIME {: RESULT = o.defaultExpression("CURRENT_TIME"); :}
    | column_options:o DEFAULT CURRENT_TIMESTAMP {: RESULT = o.defaultExpression("CURRENT_TIMESTAMP"); :}
    | column_options:o CONSTRAINT ID:n PRIMARY KEY {: RESULT = o.primaryKey().named(n); :}
    | column_options:o CONSTRAINT ID:n NOT NULL {: RESULT = o.notNull().named(n); :}
    | column_options:o CONSTRAINT ID:n UNIQUE {: RESULT = o.unique().named(n); :}
    | column_options:o CONSTRAINT ID:n DEFAULT default_value:v {: RESULT = o.defaultValue(v).named(n); :}
    | column_options:o CONSTRAINT ID:n DEFAULT LPAREN expression:e RPAREN
      {: RESULT = o.defaultExpression("(" + parser.expressionSql(eleft, eright) + ")").named(n); :}
    | column_options:o CONSTRAINT ID:n DEFAULT CURRENT_DATE {: RESULT = o.defaultExpression("CURRENT_DATE").named(n); :}
    | column_options:o CONSTRAINT ID:n DEFAULT CURRENT_TIME {: RESULT = o.defaultExpression("CURRENT_TIME").named(n); :}
    | column_options:o CONSTRAINT ID:n DEFAULT CURRENT_TIMESTAMP {: RESULT = o.defaultExpression("CURRENT_TIMESTAMP").named(n); :}
    | column_options:o CONSTRAINT ID:n CHECK LPAREN expression:e RPAREN
      {: RESULT = o.check(parser.expressionSql(eleft, eright)).named(n); :}
    | column_options:o CONSTRAINT ID:n reference_clause:f {: RESULT = o.references(f).named(n); :}
    | column_options:o CHECK LPAREN expression:e RPAREN
      {: RESULT = o.check(parser.expressionSql(eleft, eright)); :}
    | column_options:o reference_clause:f {: RESULT = o.references(f); :}
    | column_options:o DEFERRABLE initially_deferred:b {: RESULT = o.deferred(b); :}
    | column_options:o NOT DEFERRABLE initially_deferred:b {: RESULT = o.deferred(false); :}
    | {: RESULT = new ColumnOptions(false, false); :};
parent_columns ::= LPAREN column_list:c RPAREN {: RESULT = names(c); :} | {: RESULT = new ArrayList<String>(); :};
reference_clause ::= REFERENCES ID:t parent_columns:p reference_actions:o {: RESULT = ForeignKey.reference(t, p, o); :};
reference_actions ::= reference_actions:o ON DELETE reference_action:a {: o.onDelete = a; RESULT = o; :}
    | reference_actions:o ON UPDATE reference_action:a {: o.onUpdate = a; RESULT = o; :}
    | {: RESULT = new ReferenceOptions(); :};
reference_action ::= CASCADE {: RESULT = "CASCADE"; :} | RESTRICT {: RESULT = "RESTRICT"; :}
    | NO ACTION {: RESULT = "NO ACTION"; :} | SET NULL {: RESULT = "SET NULL"; :}
    | SET DEFAULT {: RESULT = "SET DEFAULT"; :};
reference_deferred ::= DEFERRABLE initially_deferred:b {: RESULT = b; :}
    | NOT DEFERRABLE initially_deferred:b {: RESULT = false; :} | {: RESULT = false; :};
initially_deferred ::= INITIALLY DEFERRED {: RESULT = true; :} | INITIALLY IMMEDIATE {: RESULT = false; :}
    | {: RESULT = false; :};
default_value ::= STRING:s {: RESULT = s; :} | NULL {: RESULT = null; :}
    | INT_VAL:n {: RESULT = new IntegerLiteral(n).getValue(); :}
    | REAL_VAL:n {: RESULT = n; :}
    | MINUS INT_VAL:n {: RESULT = new IntegerLiteral(n).negate().getValue(); :}
    | PLUS INT_VAL:n {: RESULT = new IntegerLiteral(n).getValue(); :}
    | MINUS REAL_VAL:n {: RESULT = -n; :}
    | PLUS REAL_VAL:n {: RESULT = n; :};
drop_statement ::= DROP TABLE if_exists:i table:t
    {: RESULT = new DropStatement(t); RESULT.setIfExists(i); :};
if_exists ::= IF EXISTS {: RESULT = true; :} | {: RESULT = false; :};

query ::= optional_with:w compound_query:q order_clause:o limit_clause:l
    {: q.tail(o, l); RESULT = w.isEmpty() ? q : new WithQuery(w, q); :};
optional_with ::= WITH cte_list:c {: RESULT = c; :} | {: RESULT = new ArrayList<CteDefinition>(); :};
cte_list ::= cte:c {: RESULT = new ArrayList<CteDefinition>(); RESULT.add(c); :}
    | cte_list:l COMMA cte:c {: l.add(c); RESULT = l; :};
cte ::= ID:n insert_columns:c AS LPAREN query:q RPAREN
    {: ArrayList<String> names = new ArrayList<String>();
       for (Column col : c) { if (col.getTable() != null) throw new IllegalArgumentException("CTE columns cannot be qualified"); names.add(col.getName()); }
       RESULT = new CteDefinition(n, names, q); :};
compound_query ::= select_core:s {: RESULT = s; :}
    | compound_query:l UNION select_core:r {: RESULT = new CompoundQuery(l, "UNION", r); :}
    | compound_query:l UNION ALL select_core:r {: RESULT = new CompoundQuery(l, "UNION ALL", r); :}
    | compound_query:l INTERSECT select_core:r {: RESULT = new CompoundQuery(l, "INTERSECT", r); :}
    | compound_query:l EXCEPT select_core:r {: RESULT = new CompoundQuery(l, "EXCEPT", r); :};
select_core ::= SELECT distinct:d select_list:s from_clause:f where_clause:w group_clause:g having_clause:h
    {: RESULT = new SelectStatement(s, f, w, g, h, new ArrayList<OrderBy>(), null, d); :};
distinct ::= DISTINCT {: RESULT = true; :} | ALL {: RESULT = false; :} | {: RESULT = false; :};
select_list ::= select_item:i {: RESULT = new ArrayList<Object>(); RESULT.add(i); :}
    | select_list:l COMMA select_item:i {: l.add(i); RESULT = l; :};
select_item ::= expression:e optional_alias:a {: RESULT = new SelectItem(e, a); :}
    | STAR {: RESULT = SelectItem.star(null); :}
    | ID:t DOT STAR {: RESULT = SelectItem.star(t); :};
optional_alias ::= AS ID:a {: RESULT = a; :} | ID:a {: RESULT = a; :} | {: RESULT = null; :};
alias ::= AS ID:a {: RESULT = a; :} | ID:a {: RESULT = a; :} | {: RESULT = null; :};
table_reference ::= table:t alias:a {: t.setRangeVariable(a); RESULT = t; :}
    | LPAREN query:q RPAREN alias:a
      {: RESULT = new QueryTable(q, List.of(), a == null ? parser.derivedName() : a); :};
from_clause ::= FROM from_list:f {: RESULT = f; :} | {: RESULT = new FromClause(); :};
from_list ::= table_reference:t {: RESULT = new FromClause().add(t, null, false); :}
    | from_list:f COMMA table_reference:t {: RESULT = f.add(t, null, false); :}
    | from_list:f CROSS JOIN table_reference:t {: RESULT = f.add(t, null, false); :}
    | from_list:f JOIN table_reference:t ON condition:c {: RESULT = f.add(t, c, false); :}
    | from_list:f INNER JOIN table_reference:t ON condition:c {: RESULT = f.add(t, c, false); :}
    | from_list:f LEFT optional_outer JOIN table_reference:t ON condition:c {: RESULT = f.add(t, c, true); :};
optional_outer ::= OUTER {: RESULT = ""; :} | {: RESULT = ""; :};
where_clause ::= WHERE condition:c {: RESULT = c; :} | {: RESULT = null; :};
group_clause ::= GROUP BY expressions:e {: RESULT = e; :}
    | {: RESULT = new ArrayList<CompareTerm>(); :};
having_clause ::= HAVING condition:c {: RESULT = c; :} | {: RESULT = null; :};
order_clause ::= ORDER BY order_list:o {: RESULT = o; :} | {: RESULT = new ArrayList<OrderBy>(); :};
order_list ::= ordering:o {: RESULT = new ArrayList<OrderBy>(); RESULT.add(o); :}
    | order_list:l COMMA ordering:o {: l.add(o); RESULT = l; :};
ordering ::= expression:e direction:d {: RESULT = new OrderBy(e, d); :};
direction ::= DESC {: RESULT = true; :} | ASC {: RESULT = false; :} | {: RESULT = false; :};
limit_clause ::= LIMIT limit_value:n {: RESULT = new Limit(null, n); :}
    | LIMIT limit_value:n OFFSET limit_value:o {: RESULT = new Limit(o, n); :}
    | LIMIT limit_value:o COMMA limit_value:n {: RESULT = new Limit(o, n); :}
    | {: RESULT = null; :};
limit_value ::= signed_integer:n {: RESULT = new CompareTerm(n); :}
    | PARAMETER:n {: RESULT = parser.parameter(n); :};
signed_integer ::= INT_VAL:n {: RESULT = limitInteger(n); :}
    | MINUS INT_VAL:n {: RESULT = limitInteger(n.negate()); :}
    | PLUS INT_VAL:n {: RESULT = limitInteger(n); :};

condition ::= expression:e {: RESULT = predicate(e); :};
disjunction ::= disjunction:l OR conjunction:r {: RESULT = new OrExpression(predicate(l), predicate(r)); :}
    | conjunction:e {: RESULT = e; :};
conjunction ::= conjunction:l AND factor:r {: RESULT = new AndExpression(predicate(l), predicate(r)); :}
    | factor:e {: RESULT = e; :};
factor ::= NOT factor:e {: RESULT = new NotExpression(predicate(e)); :}
    | comparison:e {: RESULT = e; :};
comparison ::= additive:l EQ additive:r {: RESULT = new Comparison(Comparison.EQ, l, r); :}
    | additive:l NOTEQ additive:r {: RESULT = new Comparison(Comparison.NOTEQ, l, r); :}
    | additive:l LT additive:r {: RESULT = new Comparison(Comparison.LT, l, r); :}
    | additive:l GT additive:r {: RESULT = new Comparison(Comparison.GT, l, r); :}
    | additive:l LTEQ additive:r {: RESULT = new Comparison(Comparison.LTEQ, l, r); :}
    | additive:l GTEQ additive:r {: RESULT = new Comparison(Comparison.GTEQ, l, r); :}
    | additive:l IS additive:r {: RESULT = new Comparison(Comparison.IS, l, r); :}
    | additive:l IS NOT additive:r {: RESULT = new Comparison(Comparison.IS_NOT, l, r); :}
    | additive:l LIKE additive:r {: RESULT = new Comparison(Comparison.LIKE, l, r); :}
    | additive:l CLIKE additive:r {: RESULT = new Comparison(Comparison.CLIKE, l, r); :}
    | additive:l NOT LIKE additive:r {: RESULT = new NotExpression(new Comparison(Comparison.LIKE, l, r)); :}
    | additive:e IN LPAREN optional_expressions:v RPAREN {: RESULT = new InExpression(e, v); :}
    | additive:e IN LPAREN query:q RPAREN {: RESULT = new InQueryExpression(e, q); :}
    | additive:e NOT IN LPAREN query:q RPAREN {: RESULT = new NotExpression(new InQueryExpression(e, q)); :}
    | additive:e NOT IN LPAREN optional_expressions:v RPAREN {: RESULT = new NotExpression(new InExpression(e, v)); :}
    | additive:e BETWEEN additive:l AND additive:r
      {: RESULT = new AndExpression(new Comparison(Comparison.GTEQ, e, l), new Comparison(Comparison.LTEQ, e, r)); :}
    | additive:e NOT BETWEEN additive:l AND additive:r
      {: RESULT = new NotExpression(new AndExpression(new Comparison(Comparison.GTEQ, e, l), new Comparison(Comparison.LTEQ, e, r))); :}
    | additive:e {: RESULT = e; :};

expressions ::= expression:e {: RESULT = new ArrayList<CompareTerm>(); RESULT.add(e); :}
    | expressions:l COMMA expression:e {: l.add(e); RESULT = l; :};
optional_expressions ::= expressions:e {: RESULT = e; :} | {: RESULT = new ArrayList<CompareTerm>(); :};
expression ::= disjunction:e {: RESULT = e; :};
additive ::= additive:l PLUS multiplicative:r {: RESULT = new ArithmeticTerm("+", l, r); :}
    | additive:l MINUS multiplicative:r {: RESULT = new ArithmeticTerm("-", l, r); :}
    | multiplicative:e {: RESULT = e; :};
multiplicative ::= multiplicative:l STAR concatenation:r {: RESULT = new ArithmeticTerm("*", l, r); :}
    | multiplicative:l DIVIDE concatenation:r {: RESULT = new ArithmeticTerm("/", l, r); :}
    | multiplicative:l REMAINDER concatenation:r {: RESULT = new ArithmeticTerm("%", l, r); :}
    | concatenation:e {: RESULT = e; :};
concatenation ::= concatenation:l CONCAT unary:r {: RESULT = new ArithmeticTerm("||", l, r); :}
    | unary:e {: RESULT = e; :};
unary ::= MINUS unary:e {: RESULT = e instanceof IntegerLiteral ? ((IntegerLiteral)e).negate() : new ArithmeticTerm("negate", e, null); :}
    | PLUS unary:e {: RESULT = e; :}
    | scalar:e {: RESULT = e; :};
scalar ::= column:c {: RESULT = c; :}
    | CAST LPAREN expression:e AS cast_type:t RPAREN {: RESULT = new CastTerm(e, t); :}
    | CASE case_base:b case_branches:c case_else:e END {: RESULT = new CaseTerm(b, c, e); :}
    | CURRENT_DATE {: RESULT = Functions.call("DATE", List.of(), false); :}
    | CURRENT_TIME {: RESULT = Functions.call("TIME", List.of(), false); :}
    | CURRENT_TIMESTAMP {: RESULT = Functions.call("DATETIME", List.of(), false); :}
    | LPAREN query:q RPAREN {: RESULT = new SubqueryTerm(q, false); :}
    | EXISTS LPAREN query:q RPAREN {: RESULT = new SubqueryTerm(q, true); :}
    | PARAMETER:n {: RESULT = parser.parameter(n); :}
    | INT_VAL:n {: RESULT = new IntegerLiteral(n); :}
    | REAL_VAL:n {: RESULT = new CompareTerm(n); :}
    | STRING:s {: RESULT = new CompareTerm(s); :}
    | NULL {: RESULT = new CompareTerm((Object) null); :}
    | LPAREN expression:e RPAREN {: RESULT = e; :}
    | ID:f LPAREN optional_expressions:e RPAREN {: RESULT = Functions.call(f, e, false); :}
    | ID:f LPAREN DISTINCT expression:e RPAREN {: RESULT = Functions.call(f, List.of(e), true); :}
    | ID:f LPAREN STAR RPAREN {: RESULT = new AggregateTerm(f, null, false); :};

case_base ::= expression:e {: RESULT = e; :} | {: RESULT = null; :};
case_branches ::= WHEN expression:w THEN expression:t
    {: RESULT = new ArrayList<CompareTerm>(); RESULT.add(w); RESULT.add(t); :}
    | case_branches:l WHEN expression:w THEN expression:t {: l.add(w); l.add(t); RESULT = l; :};
case_else ::= ELSE expression:e {: RESULT = e; :} | {: RESULT = new CompareTerm((Object)null); :};
cast_type ::= INTEGER:t {: RESULT = t; :} | REAL {: RESULT = "REAL"; :}
    | TEXT {: RESULT = "TEXT"; :} | CHAR {: RESULT = "CHAR"; :}
    | VARCHAR {: RESULT = "VARCHAR"; :} | ID:t {: RESULT = t; :};

insert_statement ::= insert_body:i upsert_clause:u returning_clause:r {: i.configure(u, r); RESULT = i; :};
insert_body ::= INSERT INTO table:t insert_columns:c VALUES value_rows:r
    {: RESULT = InsertStatement.fromRows(t, c, r); :}
    | INSERT INTO table:t insert_columns:c query:q {: RESULT = InsertStatement.fromQuery(t, c, q); :}
    | INSERT INTO table:t DEFAULT VALUES {: RESULT = InsertStatement.defaults(t); :};
conflict_target ::= LPAREN column_list:c RPAREN {: RESULT = c; :} | {: RESULT = new ArrayList<Column>(); :};
upsert_clause ::= ON CONFLICT conflict_target:c DO NOTHING {: RESULT = new Upsert(c, null, null); :}
    | ON CONFLICT conflict_target:c DO UPDATE SET assignments:a where_clause:w {: RESULT = new Upsert(c, a, w); :}
    | {: RESULT = null; :};
returning_clause ::= RETURNING select_list:s {: RESULT = s; :} | {: RESULT = null; :};
insert_columns ::= LPAREN column_list:c RPAREN {: RESULT = c; :} | {: RESULT = new ArrayList<Column>(); :};
column_list ::= column:c {: RESULT = new ArrayList<Column>(); RESULT.add(c); :}
    | column_list:l COMMA column:c {: l.add(c); RESULT = l; :};
value_rows ::= LPAREN expressions:e RPAREN
    {: RESULT = new ArrayList<ArrayList<Object>>(); RESULT.add(new ArrayList<Object>(e)); :}
    | value_rows:l COMMA LPAREN expressions:e RPAREN {: l.add(new ArrayList<Object>(e)); RESULT = l; :};
update_statement ::= UPDATE table:t SET assignments:a where_clause:w returning_clause:r
    {: UpdateStatement statement = new UpdateStatement(t, a, w); statement.setReturning(r); RESULT = statement; :};
assignments ::= assignment:a {: RESULT = new ArrayList<Column>(); RESULT.add(a); :}
    | assignments:l COMMA assignment:a {: l.add(a); RESULT = l; :};
assignment ::= column:c EQ expression:e {: c.setUpdateVal(e); RESULT = c; :};
delete_statement ::= DELETE FROM table:t where_clause:w returning_clause:r
    {: DeleteStatement statement = new DeleteStatement(t, w); statement.setReturning(r); RESULT = statement; :};
